# MS TELECOM - Hotspot System
# Use placeholders only. Real secrets stay only in the VPS .env.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-api-key
JWT_SECRET=change-me-long-random-secret
PORT=3000
CORS_ORIGINS=https://hotspot-system.vercel.app,https://mstelecom-api.duckdns.org
API_BASE_URL=https://mstelecom-api.duckdns.org
FRONTEND_BASE_URL=https://hotspot-system.vercel.app

RADIUS_SERVER_IP=40.233.118.238
RADIUS_CLIENT_MODE=global
RADIUS_VPN_SERVER_IP=10.254.1.1
VPN_INTERNAL_RADIUS_IP=10.250.0.1
RADIUS_GLOBAL_FALLBACK_SECRET=change-me-radius-fallback-secret

VPN_PUBLIC_ENDPOINT=vpn.example.com
VPN_L2TP_IPSEC_PSK=change-me-l2tp-ipsec-psk

MERCADOPAGO_ACCESS_TOKEN=TEST-or-PROD-token-placeholder
MERCADOPAGO_WEBHOOK_SECRET=webhook-secret-placeholder
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_AUTO_APPROVE_SECONDS=20

FREERADIUS_CLIENTS_PATH=/etc/freeradius/3.0/clients.d/ms-telecom-pops.conf
FREERADIUS_TMP_CLIENTS_PATH=/home/ubuntu/hotspot-system/backend/tmp/ms-telecom-pops.conf
FREERADIUS_MAIN_CLIENTS_CONF=/etc/freeradius/3.0/clients.conf
FREERADIUS_VALIDATE_CMD=sudo /usr/sbin/freeradius -C
FREERADIUS_RELOAD_CMD=sudo systemctl reload freeradius
FREERADIUS_RESTART_CMD=sudo systemctl restart freeradius

CHAP_SECRETS_PATH=/etc/ppp/chap-secrets
XL2TPD_SERVICE_NAME=xl2tpd

# Optional: protects first POP registration endpoint.
POP_REGISTER_TOKEN=change-me-pop-register-token
