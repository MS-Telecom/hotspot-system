# ========================================
# MS TELECOM - Hotspot System v3.0
# Environment Variables
# ========================================

# Server
PORT=3000
JWT_SECRET=your-jwt-secret-here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# Mercado Pago (PIX Payments)
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-token-here

# CORS (comma-separated origins)
CORS_ORIGINS=https://hotspot-system.vercel.app,https://mstelecom-api.duckdns.org

# Frontend & API URLs
API_BASE_URL=https://mstelecom-api.duckdns.org
FRONTEND_BASE_URL=https://hotspot-system.vercel.app

# RADIUS Server IP
RADIUS_SERVER_IP=40.233.118.238
